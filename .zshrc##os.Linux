
# Agent detection - only activate minimal mode for actual agents
if [[ -n "$npm_config_yes" ]] || [[ -n "$CI" ]] || [[ "$-" != *i* ]]; then
  export AGENT_MODE=true
else
  export AGENT_MODE=false
fi

ZSH_THEME=""
ZSH_DISABLE_COMPFIX="true"

fpath=($HOME/.docker/completions $fpath)
export ZSH=$HOME/.oh-my-zsh
DEFAULT_USER="mattstratton"

plugins=(colored-man-pages colorize git git-extras docker github golang nvm zsh-syntax-highlighting zsh-autosuggestions)

zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes

source $ZSH/oh-my-zsh.sh

export GOROOT="/usr/local/go"
export PATH="$GOROOT/bin:$PATH"
alias python="python3"

source ~/.zshrc_shared

. "$HOME/.atuin/bin/env"

# dedupe PATH; must come after the last PATH edit (export PATH=... bypasses -U on assignment)
typeset -U path
