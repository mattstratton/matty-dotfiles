# Agent detection - only activate minimal mode for actual agents
if [[ -n "$npm_config_yes" ]] || [[ -n "$CI" ]] || [[ "$-" != *i* ]]; then
  export AGENT_MODE=true
else
  export AGENT_MODE=false
fi

ZSH_THEME=""
ZSH_DISABLE_COMPFIX="true"
DISABLE_UPDATE_PROMPT="true"

fpath=($HOME/.docker/completions $fpath)
export ZSH=$HOME/.oh-my-zsh
DEFAULT_USER="mattstratton"

plugins=(zoxide fzf direnv brew colored-man-pages git git-extras docker gh golang macos nvm uv bun 1password sudo extract copypath copyfile zsh-completions fzf-tab zsh-you-should-use zsh-autosuggestions zsh-syntax-highlighting)

zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes

source $ZSH/oh-my-zsh.sh

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
export GOROOT="/opt/homebrew/opt/go/libexec"
export PATH=$PATH:$GOROOT/bin
alias python="/opt/homebrew/bin/python3"
alias imgls="$HOME/.iterm2/imgls"
alias imgcat="$HOME/.iterm2/imgcat"
alias ybrew="yadm add Brewfile"
alias devstation="herdr --remote matty@34.225.33.252"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_INSECURE_REDIRECT=1
fuck() { unfunction fuck; eval "$(thefuck --alias)"; fuck "$@" }
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

source ~/.zshrc_shared
