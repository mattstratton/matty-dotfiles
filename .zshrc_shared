export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/usr/local/sbin:/sbin:$HOME/bin:$PATH"

export BUNDLE_PATH=$GEM_HOME
export EDITOR='code --wait'

# secrets!

source ~/keychain-environment-variables.sh

# AWS configuration example, after doing:
# $  set-keychain-environment-variable AWS_ACCESS_KEY_ID
#       provide: "AKIAYOURACCESSKEY"
# $  set-keychain-environment-variable AWS_SECRET_ACCESS_KEY
#       provide: "j1/yoursupersecret/password"

export GITHUB_TOKEN=$(keychain-environment-variable GITHUB_TOKEN)
export CHANGELOG_GITHUB_TOKEN=$(keychain-environment-variable GITHUB_TOKEN)
export BOWIE_GITHUB_TOKEN=$(keychain-environment-variable GITHUB_TOKEN)
export HOMEBREW_GITHUB_API_TOKEN=$(keychain-environment-variable GITHUB_TOKEN)
export GITHUB_PERSONAL_ACCESS_TOKEN=$(keychain-environment-variable GITHUB_TOKEN)
export BUTTONDOWN_API_KEY=$(keychain-environment-variable BUTTONDOWN_API_KEY)

alias vim="nvim"
alias ohmyzsh="nvim ~/.oh-my-zsh"
alias zshconfig="nvim ~/.zshrc"
alias c='clear'
alias sz='source ~/.zshrc'
alias cpenv='cp ~/src/github.com/timescale/tiger-den/.env ./'
alias prep='changelog prepare'
alias -s rb=ruby
alias -s log="less -MN"
alias ypom="yadm push origin master"
alias gpom="git push origin main"
alias gitmain="git checkout main && git pull origin main"
alias gitrelease="git checkout release && git pull origin release"
alias gh="GITHUB_TOKEN= command gh"

export GOPATH=~/go/
export PATH=$PATH:$GOPATH/bin
export DODPATH=$HOME/src/github.com/devopsdays/devopsdays-web/
export PATH="$HOME/.cargo/bin:$PATH"

bindkey "^[[1;3C" forward-word
bindkey "^[[1;3D" backward-word

if command -v ngrok &>/dev/null; then
  eval "$(ngrok completion)"
fi

if [[ "$AGENT_MODE" == "true" ]]; then
  export EDITOR='nvim'
  PROMPT='%n@%m:%~%# '
  RPROMPT=''
  unsetopt CORRECT
  unsetopt CORRECT_ALL
  setopt NO_BEEP
  setopt NO_HIST_BEEP
  setopt NO_LIST_BEEP
  alias rm='rm -f'
  alias cp='cp -f'
  alias mv='mv -f'
  alias npm='npm --no-fund --no-audit'
  alias yarn='yarn --non-interactive'
  alias pip='pip --quiet'
  alias git='git -c advice.detachedHead=false'
fi

# keep literal secrets out of ~/.zsh_history; mirrors history_filter in ~/.config/atuin/config.toml
_no_secrets_in_history() {
  setopt localoptions nocasematch
  local re='napi_[a-z0-9]{20,}|[a-z]+://[^:/@[:space:]]+:[^@/[:space:]]+@|[a-z0-9_]*(api_?key|secret|token|passw(or)?d)[a-z0-9_]*=[^[:space:]$]{8,}|bearer[[:space:]]+[a-z0-9._~+/-]{16,}'
  [[ ! $1 =~ $re ]]
}
autoload -Uz add-zsh-hook
add-zsh-hook zshaddhistory _no_secrets_in_history

export PATH="$HOME/.local/bin:$HOME/.atuin/bin:$PATH"
eval "$(atuin init zsh)"
eval "$(starship init zsh)"

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

issue() { local n="TDEN-${${(U)1}#TDEN-}"; claude --permission-mode plan -w "issue-$n" "/implement-issue $n" }
source ~/.config/herdr/tiger-den.zsh
alias reherd='source ~/.config/herdr/tiger-den.zsh'

# image conversion: svg via rsvg-convert (better fidelity), everything else via magick
# topng file.svg [width_px]  (width only applies to svg); output lands next to the input
topng() {
  local in="$1" out="${1%.*}.png" w=()
  [[ -n "$2" ]] && w=(-w "$2")
  case "${in:l}" in
    *.svg) rsvg-convert $w "$in" -o "$out" ;;
    *)     magick "$in" "$out" ;;
  esac && echo "→ $out"
}
# topng_all svg [width_px]  (every *.svg in cwd)
topng_all() { for f in *.$1; do topng "$f" $2; done }
# conv photo.png webp
conv() { magick "$1" "${1%.*}.$2" && echo "→ ${1%.*}.$2" }
